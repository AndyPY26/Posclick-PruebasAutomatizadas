# Plantilla de variables de entorno de la suite E2E POSCLICK.
# Copiar a .env y completar con los valores reales (pedirlos al equipo QA).
# El .env NO se versiona; este archivo sí.

# Centro POS para el que está armado el dataset (SKU_POOL, cédulas, oferta).
# globalSetup detiene la suite si el encabezado del POS muestra otro centro.
E2E_CENTRO_ESPERADO=004-150

# SSO Azure AD (login del POS)
E2E_SSO_EMAIL=
E2E_SSO_PASSWORD=

# Autorización de supervisor (entrega de caja, entrega futura, reimpresión)
# Trama tal como la emite el lector de banda magnética, con el % inicial:
#   %<tarjeta>;<id>;<NOMBRE COMPLETO>
E2E_SUPERVISOR_TRAMA=
E2E_SUPERVISOR_CLAVE=
# Opcional: por defecto se toma el tercer campo de la trama.
E2E_SUPERVISOR_NOMBRE=

# Código de vendedor/asesor
E2E_CODIGO_VENDEDOR=

# Oferta especial vigente para la caja (Caso 2)
E2E_OFERTA_CUPON=
E2E_OFERTA_CEDULA=

# Cédulas de clientes de prueba (CLUB PYCCA), separadas por coma, sin espacios.
# Incluir algunas con cupo de Crédito PYCCA para el Caso 5.
E2E_CEDULA_POOL=
