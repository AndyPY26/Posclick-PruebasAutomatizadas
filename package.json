{
  "name": "posclick-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Suite E2E POSCLICK (Playwright) + planes TestSprite",
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('evidencias/test-results', { recursive: true, force: true }); fs.rmSync('evidencias/html-report', { recursive: true, force: true }); if (fs.existsSync('evidencias')) fs.readdirSync('evidencias').filter((f) => f.endsWith('.png')).forEach((f) => fs.rmSync('evidencias/' + f)); fs.mkdirSync('evidencias/test-results', { recursive: true });\"",
    "pretest": "npm run clean",
    "pretest:caso1": "npm run clean",
    "pretest:caso2": "npm run clean",
    "pretest:caso3": "npm run clean",
    "pretest:caso4": "npm run clean",
    "pretest:caso5": "npm run clean",
    "pretest:caso6": "npm run clean",
    "pretest:caso7": "npm run clean",
    "pretest:headed": "npm run clean",
    "test": "playwright test",
    "test:caso1": "playwright test -g \"Caso 1\"",
    "test:caso2": "playwright test -g \"Caso 2\"",
    "test:caso3": "playwright test -g \"Caso 3\"",
    "test:caso4": "playwright test -g \"Caso 4\"",
    "test:caso5": "playwright test -g \"Caso 5\"",
    "test:caso6": "playwright test -g \"Caso 6\"",
    "test:caso7": "playwright test -g \"Caso 7\"",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report ./evidencias/html-report",
    "trace": "playwright show-trace",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
