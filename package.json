{
  "name": "posclick-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Suite E2E POSCLICK (Playwright) + planes TestSprite",
  "scripts": {
    "test": "playwright test",
    "test:caso1": "playwright test -g \"Caso 1\"",
    "test:caso2": "playwright test -g \"Caso 2\"",
    "test:caso3": "playwright test -g \"Caso 3\"",
    "test:caso4": "playwright test -g \"Caso 4\"",
    "test:caso5": "playwright test -g \"Caso 5\"",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report ./evidencias/html-report",
    "trace": "playwright show-trace",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
