# Plantilla de variables de entorno de la suite E2E POSCLICK.
# Copiar a .env y completar con los valores reales (pedirlos al equipo QA).
# El .env NO se versiona; este archivo sí.

# Centro POS. Vacío = modo automático: corre en cualquier centro con datos en
# tests/fixtures/centros.ts. Con valor (ej. 004-150) = modo estricto: la suite
# se detiene si el POS muestra otro centro.
E2E_CENTRO_ESPERADO=

# SSO Azure AD (login del POS)
E2E_SSO_EMAIL=
E2E_SSO_PASSWORD=

# Autorización de supervisor (entrega de caja, entrega futura, reimpresión)
# Trama tal como la emite el lector de banda magnética, con el % inicial:
#   %<tarjeta>;<id>;<NOMBRE COMPLETO>
E2E_SUPERVISOR_TRAMA=
E2E_SUPERVISOR_CLAVE=
# Opcional: por defecto se toma el tercer campo de la trama.
E2E_SUPERVISOR_NOMBRE=

# Código de vendedor/asesor
E2E_CODIGO_VENDEDOR=


# Cédulas de clientes de prueba (CLUB PYCCA), separadas por coma, sin espacios.
E2E_CEDULA_POOL=

# Datos por centro (tests/fixtures/centros.ts). Prefijo E2E_<centro con _>_.
# OFERTA_*: Caso 2 (se salta si no hay oferta vigente). CREDITO: cédulas con
# cupo de Crédito PYCCA para el Caso 5, separadas por coma (vacío → se salta).
E2E_004_150_OFERTA_CUPON=
E2E_004_150_OFERTA_CEDULA=
E2E_004_150_CREDITO=
E2E_004_112_OFERTA_CUPON=
E2E_004_112_OFERTA_CEDULA=
E2E_004_112_CREDITO=
